# Google Sheet
GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account"}'
GOOGLE_SHEET_ID=your-google-sheet-id
GOOGLE_SHEET_TAB=Posts

# Bluesky app password (create one in Bluesky account settings)
BLUESKY_HANDLE=your.handle.bsky.social
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Mastodon (optional until the Mastodon adapter is tested)
MASTODON_BASE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# LinkedIn personal profile (optional until the LinkedIn adapter is tested)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_REFRESH_TOKEN=
LINKEDIN_ACCESS_TOKEN_EXPIRES_AT=0
LINKEDIN_AUTHOR_URN=urn:li:person:your-member-id
LINKEDIN_VERSION=202607

# Discord incoming webhook for failure alerts (optional)
DISCORD_WEBHOOK_URL=

# Optional failure notification, used in a later milestone
DISCORD_WEBHOOK_URL=
