<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Currently unused: GitHub Actions is the active runner. -->
  <key>Label</key><string>com.example.social-auto-poster</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/YOUR_USER/social-auto-poster/.venv/bin/social-auto-poster</string>
    <string>--live</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/YOUR_USER/social-auto-poster</string>
  <key>StartInterval</key><integer>1800</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/tmp/social-auto-poster.log</string>
  <key>StandardErrorPath</key><string>/tmp/social-auto-poster-error.log</string>
</dict>
</plist>
